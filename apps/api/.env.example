# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Supabase ─────────────────────────────────────────────────────────────────
# Use the service role key (NOT the anon key) — needed to verify JWTs server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Legal API keys (all optional — remove params if unused) ──────────────────
COURTLISTENER_TOKEN=your-token
GOVINFO_KEY=your-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (add your Vercel domain + localhost)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Rate limiting ─────────────────────────────────────────────────────────────
ANTHROPIC_RPM=60
LEGAL_RPM=120
