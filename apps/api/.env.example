# ── LLM Provider (pick one — Groq is free, Anthropic is paid) ────────────────

# OPTION A: Groq (free tier — recommended for zero-cost deploys)
# Sign up at https://console.groq.com → API Keys → Create Key
# Free limits: 14,400 req/day, 500K tokens/min
GROQ_API_KEY=gsk_...

# OPTION B: Anthropic Claude (paid, higher quality for complex legal reasoning)
# If both are set, Groq takes priority.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Supabase (optional — skip for free/demo deploys) ─────────────────────────
# Without these, auth is bypassed and all requests are accepted as "anon".
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# ── Legal API keys (all optional — free tiers available) ─────────────────────
# COURTLISTENER_TOKEN=your-token
# GOVINFO_KEY=your-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL when deployed
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Rate limiting ─────────────────────────────────────────────────────────────
ANTHROPIC_RPM=60
LEGAL_RPM=120
