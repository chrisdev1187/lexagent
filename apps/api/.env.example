# ── LLM Provider (pick one — Groq is free, Anthropic is paid) ────────────────

# Provider waterfall: tried in order, skips on 429/error, first success wins.
# Add as many as you want — more keys = more redundancy.

# Groq (free) — console.groq.com
GROQ_API_KEY=gsk_...
# Cerebras (free) — cloud.cerebras.ai
# CEREBRAS_API_KEY=csk-...
# SambaNova (free) — cloud.sambanova.ai
# SAMBANOVA_API_KEY=...
# OpenRouter (free tier) — openrouter.ai
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA (free) — integrate.api.nvidia.com
# NVIDIA_API_KEY=nvapi-...
# xAI Grok (free tier) — console.x.ai
# XAI_API_KEY=xai-...
# Mistral (free tier) — console.mistral.ai
# MISTRAL_API_KEY=...
# Google Gemini (free) — aistudio.google.com
# GEMINI_API_KEY=AIza...
# GEMINI_API_KEY_2=AIza...   ← second account for rotation

# Anthropic Claude (paid — fallback when all free providers are exhausted)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Supabase (optional — skip for free/demo deploys) ─────────────────────────
# Without these, auth is bypassed and all requests are accepted as "anon".
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# ── Legal API keys (all optional — free tiers available) ─────────────────────

# CourtListener — courtlistener.com/register (free)
# COURTLISTENER_TOKEN=your-token

# api.data.gov — api.data.gov/signup (free) — ONE KEY covers 3 APIs:
#   GovInfo (US Code, CFR, Federal Register)
#   Congress.gov (bills, amendments, voting records)
#   Regulations.gov (federal rulemaking, agency dockets)
# DATA_GOV_KEY=your-key

# OpenStates — openstates.org/accounts/signup (free)
# OPENSTATES_KEY=your-key

# Free / no-key APIs (always active, no setup needed):
#   eCFR: ecfr.gov — live Code of Federal Regulations
#   SEC EDGAR: sec.gov — corporate filings full-text search
#   USPTO PatentsView: patentsview.org — patent database

# ── CORS ─────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL when deployed
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Rate limiting ─────────────────────────────────────────────────────────────
ANTHROPIC_RPM=60
LEGAL_RPM=120
