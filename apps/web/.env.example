# ── Backend proxy (production — routes all AI + legal API calls through apps/api) ─
# Set this to your deployed API URL (Render, Railway, Fly.io, etc.)
# When set: no client-side API key needed, auth headers injected automatically.
# Leave empty for demo mode (user enters Anthropic key in onboarding).
# VITE_API_URL=https://lexagent-api.onrender.com

# ── Demo mode (no backend) ────────────────────────────────────────────────────
# Convenience shortcut — can also be set in the in-app onboarding wizard.
# VITE_ANTHROPIC_KEY=sk-ant-api03-...

# ── Supabase (optional — skip for free/demo deploys) ─────────────────────────
# Without these, auth gate is bypassed and localStorage is used for all storage.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
