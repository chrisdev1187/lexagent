# ── Demo mode (no backend, no Supabase) ──────────────────────────────────────
# Just set this and run `pnpm dev`. The key is also settable via the in-app
# onboarding wizard (stored in localStorage) — env var is a convenience shortcut.
VITE_ANTHROPIC_KEY=sk-ant-api03-...

# ── Backend proxy (production) ────────────────────────────────────────────────
# Set this to route all AI + legal API calls through apps/api (hides the key).
# Leave empty for demo / local dev.
# VITE_API_URL=https://your-api.railway.app

# ── Supabase (optional — skip for demo, localStorage is used instead) ─────────
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
